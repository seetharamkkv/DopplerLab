{
  "file_purpose": "Replication record for the clip-level CTC package. The position-estimation ablations live in position_ctc/outputs/ablate/ablations.json and are not repeated here.",
  "experiment_name": "ctc_exp token CTC, retrieval, and tracker heads",
  "train_time_seconds": null,
  "timing_note": "No run stored a duration. train_time_seconds is null.",
  "environment": {
    "device_recorded_for_token_ctc": "mps",
    "audio": {
      "sample_rate_hz": 22050,
      "n_fft": 2048,
      "hop": 512,
      "n_mels": 128,
      "representation": "log-mel, preferring an exported log_mel.npy when present"
    }
  },
  "alphabet": {
    "blank": "_",
    "phases": [
      "SIL",
      "APR",
      "CPA",
      "REC"
    ],
    "speed_bins_mps": [
      10,
      15,
      20,
      25,
      30,
      35,
      40,
      45,
      50
    ],
    "speed_rule": "Round to the nearest 5 m/s and clamp to [10, 50].",
    "range_edges_m": [
      5,
      10,
      20,
      40,
      80
    ],
    "range_rule": "Smallest edge that is greater than or equal to the range, else R80."
  },
  "model": {
    "class": "CtcKinematics",
    "encoder": "Conv1d 128\u219264 k5 pool2, Conv1d 64\u2192128 k5 pool2, 2-layer bidirectional GRU hidden 192 per direction (384), dropout 0.1 between GRU layers.",
    "ctc_head": "Linear 384 \u2192 alphabet size, including blank.",
    "speed_head": "Attention pool over time, then Linear 384\u2192128, ReLU, dropout 0.3, Linear 128\u21929 speed bins.",
    "trajectory_heads": "Per-frame xy linear map, plus a velocity residual of at most 2.5 m/s around the chosen speed-bin center times a unit direction."
  },
  "datasets": {
    "path_file": "dataset_paths.json (copy from dataset_paths.example.json) or env DOPPLER_VS13 / DOPPLER_SIM_TEST / DOPPLER_SIM_UNCONSTRAINED",
    "path_file_status": "Local file is not in git. Keys required by the loader are vs13, dopplersim_test_dataset, and dopplersim_unconstrained.",
    "sim": "DopplerSim test set. Phase 0 counted 1000 clips. CTC test_n is 148.",
    "vs13": "VS13 pass-bys. Phase 0 counted 400 clips. CTC test_n is 58. Range tokens are absent.",
    "tracker_splits": "unconstrained and unconstrained_velcond use the unconstrained free-path set. straight_pos uses straight pass-bys. Each reports test_n 148. These are not the same clips as the sim CTC test set even when sample ids coincide."
  },
  "how_to_read_the_numbers": {
    "sim_and_vs13_phase1": "Greedy CTC decode. speed_bin_acc and speed_mae_mps compare the decoded speed token with the clip speed. token_error_rate is string edit distance.",
    "phase2": "Retrieval at 10 neighbors in decoded-string space. recall_speed is the fraction of neighbors whose true speed matches the query. On sim, recall_range is 1 because every string contains R05.",
    "tracker_runs": "run_track.py unpacks CTC logits as _ctc and does not put CTC loss in the objective. speed_bin_acc is the argmax of the separate clip-level speed classifier. The 0.9189 figure on unconstrained_velcond is that classifier, not a CTC decode."
  },
  "tracker_loss": {
    "unconstrained_and_velcond": "2 * focal speed CE + 0.75 * collapse + 4 * speed-magnitude residual + 2 * direction + 1 * xy Huber + 0.25 * consistency.",
    "straight_pos": "Same speed and velocity terms. The summary records label_source pythagoras_from_speed_cpa_wav_times and audio_only true. The decoded speed histogram is entirely V20, matching the majority baseline."
  },
